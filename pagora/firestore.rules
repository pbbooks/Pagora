rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // STRICT BLOCKADE: Only the master administrative email is allowed to read or write 
    // to this Firebase database. (Public books are safely handled by PocketBase).
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == "testcodecfg@gmail.com";
    }
  }
}
